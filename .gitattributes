# 글꼴 정본 — Git LFS (Fonts/만, 용량 작음)
Fonts/*.ttf filter=lfs diff=lfs merge=lfs -text
Fonts/*.otf filter=lfs diff=lfs merge=lfs -text

# Media/Assets/(영상·음원·이미지)는 Git LFS 대역폭 한도 초과로 Nextcloud 이관.
# 상세: docs/data/repo.md "미디어 (Media/Assets)"

# 재생목록·라이브러리 인덱스 — working tree=이 PC 절대경로, Git=%USERPROFILE% portable
# 각 PC 1회: powershell -File scripts/setup-git-filters.ps1
Playlists/Library filter=pp-paths
Playlists/Media filter=pp-paths
Libraries/LibraryData filter=pp-paths

# Mac 셸 스크립트 — Windows 체크아웃 시 CRLF로 바뀌면 실행 안 됨
*.sh text eol=lf
