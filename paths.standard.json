{
  "_doc": "현장 PC 공통 경로. PC마다 바꾸는 값만 %USERPROFILE% 등.",
  "show_directory": "%USERPROFILE%\\Documents\\pro-presenter",
  "pp_library_subdir": "예배",
  "paths_derived": {
    "pp_library_dir": "%USERPROFILE%\\Documents\\pro-presenter\\Libraries\\예배",
    "media_dir": "%USERPROFILE%\\Documents\\pro-presenter\\Media",
    "playlists_dir": "%USERPROFILE%\\Documents\\pro-presenter\\Playlists",
    "themes_dir": "%USERPROFILE%\\Documents\\pro-presenter\\Themes",
    "fonts_dir": "%USERPROFILE%\\Documents\\pro-presenter\\Fonts"
  },
  "content_model": {
    "_doc": "PP UI는 재생목록(Playlists) 기준. 재생목록 항목은 Libraries/*.pro 참조.",
    "primary_git_paths": ["Libraries/", "Playlists/", "Presets/", "Themes/", "Fonts/", "Media/Assets/"]
  },
  "github": {
    "assets_repo": "EHWIYA/pro-presenter-data",
    "front_end_repo": "EHWIYA/pro-presenter-front-end",
    "back_end_repo": "EHWIYA/pro-presenter-back-end"
  },
  "docs": "docs/index.md",
  "platforms": {
    "macos": {
      "pp_show_directory": "$HOME/Documents/pro-presenter",
      "pp_library_default": "$HOME/Documents/pro-presenter/Libraries/예배",
      "portable_home_token": "$HOME",
      "icloud_policy": "A_disable_desktop_and_documents"
    }
  }
}
