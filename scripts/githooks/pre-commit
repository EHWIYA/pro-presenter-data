#!/bin/sh
# Require pp-paths filter so commit stores portable paths (not this PC absolute).
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! git config --get filter.pp-paths.clean >/dev/null; then
  echo "ERROR: pp-paths Git filter not configured." >&2
  echo "Run once:  powershell -File scripts/setup-git-filters.ps1" >&2
  exit 1
fi
# Working tree stays portable after pull; run smudge-files before PP.
# Re-add targets so clean filter always runs before commit.
for f in Playlists/Library Playlists/Media Libraries/LibraryData; do
  if [ -f "$f" ] && git diff --cached --name-only | grep -qx "$f"; then
    git add -- "$f"
  fi
done
# If any of the three are dirty in the index sense with absolute paths only in WT
# and user is committing other files, still fine. If WT has absolute and they're
# part of commit via -a, clean filter handles it.
exit 0
